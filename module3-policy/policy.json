{
  "version": "1.0",
  "default_action": "block",
  "description": "TrueIntent MCP Security Policy - Default-Deny Configuration",
  "allowed_tools": {
    "ping": {
      "action": "allow",
      "description": "Network connectivity testing",
      "allowed_arguments": {
        "host": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.-]+$",
          "max_length": 253
        }
      }
    },
    "get_github_issue": {
      "action": "allow",
      "description": "Fetch public repository issue for inspection",
      "allowed_arguments": {
        "repo": {
          "type": "string",
          "max_length": 500
        },
        "issue_number": {
          "type": "integer"
        }
      }
    },
    "read_file": {
      "action": "allow",
      "description": "Read files from workspace only",
      "allowed_paths": [
        "*/workspace/**",
        "*/public_repo/**",
        "/var/log/**"
      ],
      "forbidden_paths": [
        "/etc/shadow",
        "/etc/passwd",
        "/root/**",
        "**/.ssh/**",
        "**/.aws/**",
        "**/id_rsa**",
        "**/.env*",
        "**/private_repo/**",
        "**/*token*"
      ]
    },
    "write_file": {
      "action": "allow",
      "description": "Write files to workspace only",
      "allowed_paths": [
        "./workspace/**"
      ],
      "forbidden_paths": [
        "**/.*",
        "**/.git/**",
        "**/.ssh/**"
      ],
      "max_file_size": 10485760
    },
    "list_dir": {
      "action": "allow",
      "description": "List directory contents",
      "allowed_paths": [
        "./workspace/**",
        "/var/log/**"
      ]
    },
    "search": {
      "action": "allow",
      "description": "Web search capability",
      "allowed_arguments": {
        "query": {
          "type": "string",
          "max_length": 500
        }
      }
    },
    "execute_command": {
      "action": "allow",
      "description": "Command execution capability subject to semantic threat inspection",
      "allowed_arguments": {
        "cmd": {
          "type": "string",
          "max_length": 4096
        }
      }
    },
    "fetch_url": {
      "action": "block",
      "description": "External URL fetching is disabled to prevent exfiltration"
    },
    "sudo": {
      "action": "block",
      "description": "Privileged operations are forbidden"
    }
  }
}
